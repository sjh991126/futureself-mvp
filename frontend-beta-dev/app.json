{
  "name": "trippy",
  "version": "0.1.3",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "cd ios\npod install",
    "web": "expo start --web"
  },
  "dependencies": {
    "@expo/vector-icons": "^14.0.2",
    "@gorhom/bottom-sheet": "^5.2.6",
    "@react-native-async-storage/async-storage": "^1.23.1",
    "@react-native-community/geolocation": "^3.2.1",
    "@types/react": "~19.2.2",
    "axios": "^1.7.2",
    "date-fns": "^3.6.0",
    "expo": "~51.0.9",
    "expo-apple-authentication": "~6.4.1",
    "expo-constants": "~16.0.2",
    "expo-image-picker": "^15.0.7",
    "expo-linear-gradient": "~13.0.2",
    "expo-linking": "~6.3.1",
    "expo-location": "~17.0.1",
    "expo-router": "~3.5.14",
    "expo-status-bar": "~1.12.1",
    "moment": "^2.30.1",
    "nativewind": "^2.0.11",
    "react": "19.1.0",
    "react-native": "^0.74.2",
    "react-native-big-calendar": "^4.13.0",
    "react-native-calendars": "^1.1305.0",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-gesture-handler": "~2.16.1",
    "react-native-linear-gradient": "^2.8.3",
    "react-native-loader-kit": "^2.0.8",
    "react-native-maps": "^1.14.0",
    "react-native-reanimated": "3.10",
    "react-native-redash": "^18.1.3",
    "react-native-safe-area-context": "4.10.1",
    "react-native-screens": "3.31.1",
    "react-native-svg": "^15.3.0",
    "typescript": "~5.3.3"
  },
  "devDependencies": {
    "@babel/core": "^7.20.0",
    "tailwindcss": "^3.3.2"
  },
  "private": true,
  "expo": {
    "scheme": "trippy",
    "plugins": [
      [
        "expo-location",
        {
          "locationAlwaysAndWhenInUsePermission": "Allow Trippy to use your location."
        }
      ],
      "expo-router",
      "expo-font",
      "expo-secure-store"
    ],
    "orientation": "portrait",
    "extra": {
      "eas": {
        "projectId": "65001fbc-2f82-40ff-abbc-89847d6bd90f"
      }
    },
    "icon": "./assets/appIcon.png",
    "splash": {
      "image": "./assets/splash.png",
      "resizeMode": "contain",
      "backgroundColor": "#25292e"
    },
    "android": {
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION"
      ],
      "package": "com.anonymous.trippy"
    },
    "ios": {
      "bundleIdentifier": "com.anonymous.trippy",
      "infoPlist": {
        "UIStatusBarHidden": false,
        "UIViewControllerBasedStatusBarAppearance": false,
        "NSLocationWhenInUseUsageDescription": "Trippy needs your location to show nearby places and events.",
        "NSLocationAlwaysAndWhenInUseUsageDescription": "Trippy needs your location to provide personalized content."
      },
      "appleTeamId": "27RC75JBUD",
      "CFBundleURLTypes": [
        {
          "CFBundleURLSchemes": [
            "com.googleusercontent.apps.293792261808-3ssdvgjctv3n1so7cspft62cm6enhisd"
          ]
        }
      ]
    }
  }
}