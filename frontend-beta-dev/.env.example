# ── Trippy frontend — copy to .env and fill in ─────────────────────────
# Restart Metro with cache clear after editing: npx expo start -c

# Backend API. Local stack: use your machine's LAN IP, NOT localhost
# (the phone/emulator can't reach localhost on your laptop).
# Android emulator can use http://10.0.2.2:8080
API_BASE_URL=http://192.168.0.10:8080

# Google Sign-In
GOOGLE_WEB_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_IOS_CLIENT_ID=xxxxxxxx.apps.googleusercontent.com
GOOGLE_SECRET_KEY=

# Firebase (from google-services.json / GoogleService-Info.plist)
YOUR_API_KEY=
YOUR_AUTH_DOMAIN=your-project.firebaseapp.com
YOUR_PROJECT_ID=your-project
YOUR_STORAGE_BUCKET=your-project.appspot.com
YOUR_MESSAGING_SENDER_ID=
YOUR_APP_ID=

# Stripe (optional)
STRIPE_PUBLISHABLE_KEY=pk_test_xxx

# AWS S3 (analytics/logs upload — app/src/api/s3_upload.js)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
